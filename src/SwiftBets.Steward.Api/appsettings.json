{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Kafka": {
    "BootstrapServers": "",
    "Environment": "dev",
    "ClientId": "swiftbets-steward"
  },
  "Jwt": {
    "Authority": "",
    "Audience": "swiftbets",
    "RequireHttpsMetadata": true
  },
  "Steward": {
    "Model": "claude-sonnet-5-5",
    "MaxTurns": 8,
    "MaxTokens": 8000,
    "MonthlyBudgetUsd": 10,
    "Pricing": {
      "claude-sonnet-5-5": [
        2.0,
        10.0,
        2.5,
        0.2
      ],
      "claude-haiku-4-5": [
        1.0,
        5.0,
        1.25,
        0.1
      ]
    },
    "Embeddings": {
      "Provider": "hashing"
    },
    "ModelProvider": {
      "Provider": "replay",
      "ReplayDirectory": "transcripts"
    }
  },
  "ServiceIdentity": {
    "TokenEndpoint": "",
    "ClientId": "steward",
    "ClientSecret": ""
  },
  "Platform": {
    "SettlementAddress": "",
    "PayoutAddress": "",
    "OfferAddress": "",
    "WalletAddress": "",
    "PrometheusAddress": ""
  },
  "Status": {
    "PollSeconds": 30,
    "Components": []
  }
}
